# Supabase Connect > Session pooler (port 5432); URL-encode the password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
# Direct or session-pooler connection used by Prisma migrations.
DIRECT_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
TEST_DATABASE_URL="postgresql://postgres@127.0.0.1:55432/orven_test"
APP_URL="http://localhost:3000"
SUPABASE_URL="https://PROJECT_REF.supabase.co"
# Use the Supabase publishable key (or legacy anon key), never a secret/service_role key.
SUPABASE_ANON_KEY=""
# Server-only Supabase secret key for administrator product photo uploads.
# Never expose this key in browser code or commit a real value.
SUPABASE_SECRET_KEY=""
# Optional legacy service_role JWT; SUPABASE_SECRET_KEY is preferred.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PRODUCT_IMAGES_BUCKET="product-images"
PAYMENT_MODE="sandbox"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
CRON_SECRET=""
SEED_ADMIN_PASSWORD=""
SEED_CUSTOMER_PASSWORD=""
